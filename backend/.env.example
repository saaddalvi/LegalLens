GOOGLE_API_KEY=
WEB_SEARCH_API_KEY=
# Optional; free-tier quotas are per model (3.8-flash allows only 20 requests/day)
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional; a second model tried once when the first still fails after its retries (503, spent quota)
GEMINI_FALLBACK_MODEL=
# Optional; per client address, on /ask and /ask/stream. Set both to 0 to turn limiting off.
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=50
# Optional, for deployments. REQUIRE_CORPUS=1 fails instead of seeding the 3-Provision sample
# Corpus when the store is empty; WARM_START=1 loads the Corpus and embedding model at startup.
# /health says the process is up; /ready says the Corpus loads and whether it is the sample.
REQUIRE_CORPUS=
WARM_START=
# Optional; answers to repeated Queries are remembered in memory. Size 0 turns it off.
ANSWER_CACHE_SIZE=500
ANSWER_CACHE_TTL_SECONDS=86400
